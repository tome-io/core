{
  "expo": {
    "name": "Tomeio",
    "slug": "tomeio",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tomeio",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#100B08",
    "primaryColor": "#FF6A00",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "org.tomeio.app"
    },
    "android": {
      "package": "org.tomeio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFB511",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100B08",
          "image": "./assets/images/icon.png",
          "imageWidth": 180
        }
      ],
      [
        "./modules/expo-launcher-icon/app.plugin.js",
        {
          "monochromeSvg": "./assets/images/android-icon-monochrome.svg"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
