{
  "name": "@tomeio/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@kesha-antonov/react-native-background-downloader": "4.6.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tomeio/design": "workspace:*",
    "@tomeio/domain": "workspace:*",
    "@tomeio/extension-protocol": "workspace:*",
    "@tomeio/extension-runtime": "workspace:*",
    "@tomeio/official-extensions": "workspace:*",
    "@tomeio/sync": "workspace:*",
    "expo": "~57.0.17",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "jszip": "^3.10.1",
    "nativewind": "^4.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.35.0",
    "react-native-readium": "5.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:android": "expo start --dev-client --android",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "android": "bun run prebuild:android && expo run:android",
    "android:release": "bun run prebuild:android && expo run:android --variant release",
    "build:android:beta": "./scripts/build-eas-android.sh beta",
    "build:android:production": "./scripts/build-eas-android.sh production",
    "ios": "bun run prebuild:ios && expo run:ios",
    "build:ios:beta": "./scripts/build-eas-ios.sh beta",
    "build:ios:production": "./scripts/build-eas-ios.sh production",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "tsx --test scripts/enrichment-test.mjs scripts/acquisition-options-test.ts scripts/declarative-workflow-test.ts scripts/extension-updates-test.ts scripts/hosted-sync-record-test.ts scripts/koreader-document-test.ts scripts/library-state-test.ts scripts/library-sync-model-test.ts scripts/reader-metrics-test.ts",
    "test:acquisition": "tsx --test scripts/acquisition-options-test.ts",
    "test:enrichment": "tsx --test scripts/enrichment-test.mjs",
    "test:enrichment:live": "LIVE_OPENLIBRARY=1 tsx --test scripts/enrichment-test.mjs",
    "typecheck": "tsc --noEmit",
    "ios:onboarding": "EXPO_PUBLIC_ONBOARDING_PREVIEW=1 expo start --dev-client --ios --port 8082 --clear"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "private": true
}
