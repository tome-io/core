new file mode 100644
index 0000000000000000000000000000000000000000..70f0d9e7e7837ee75e24772f6362d72aa21a7776
--- /dev/null
+++ b/android/src/main/java/com/reactnativereadium/reader/ReadiumWebViewAccess.java
@@ -0,0 +1,101 @@
+package com.reactnativereadium.reader;
+
+import android.graphics.Rect;
+import android.net.Uri;
+import android.view.View;
+import android.view.ViewGroup;
+import java.util.ArrayList;
+import java.util.List;
+import org.readium.r2.navigator.R2BasicWebView;
+import org.readium.r2.navigator.R2WebView;
+
+/** Java bridge for Readium APIs which are public in bytecode but Kotlin-internal. */
+final class ReadiumWebViewAccess {
+  private ReadiumWebViewAccess() {}
+
+  static Double progressionFor(View root, String href) {
+    R2BasicWebView webView = activeWebView(root, href, R2BasicWebView.class);
+    return webView == null ? null : webView.getProgression();
+  }
+
+  static int[] paginationFor(View root, String href) {
+    R2WebView webView = activeWebView(root, href, R2WebView.class);
+    if (webView == null || webView.getScrollMode()) return null;
+
+    // Readium updates this after settling a swipe. Calling it here also keeps
+    // the value accurate when a location is requested between scroll events.
+    webView.updateCurrentItem$readium_navigator();
+    int pageCount = webView.getNumPages$readium_navigator();
+    int pageIndex = webView.getMCurItem$readium_navigator();
+    if (pageCount <= 0) return null;
+    return new int[] {
+      Math.max(1, Math.min(pageIndex + 1, pageCount)),
+      pageCount
+    };
+  }
+
+  private static <T extends R2BasicWebView> T activeWebView(
+    View root,
+    String href,
+    Class<T> type
+  ) {
+    List<T> webViews = new ArrayList<>();
+    collectWebViews(root, type, webViews);
+
+    T bestMatch = null;
+    int bestMatchArea = -1;
+    T bestVisible = null;
+    int bestVisibleArea = -1;
+    for (T webView : webViews) {
+      int visibleArea = visibleArea(webView);
+      if (visibleArea > bestVisibleArea) {
+        bestVisible = webView;
+        bestVisibleArea = visibleArea;
+      }
+      if (matchesResource(webView, href) && visibleArea > bestMatchArea) {
+        bestMatch = webView;
+        bestMatchArea = visibleArea;
+      }
+    }
+    return bestMatch != null ? bestMatch : bestVisible;
+  }
+
+  private static <T extends R2BasicWebView> void collectWebViews(
+    View root,
+    Class<T> type,
+    List<T> result
+  ) {
+    if (type.isInstance(root)) result.add(type.cast(root));
+    if (!(root instanceof ViewGroup)) return;
+
+    ViewGroup group = (ViewGroup) root;
+    for (int index = 0; index < group.getChildCount(); index++) {
+      collectWebViews(group.getChildAt(index), type, result);
+    }
+  }
+
+  private static boolean matchesResource(R2BasicWebView webView, String href) {
+    Object url = webView.getResourceUrl();
+    if (url == null) return false;
+    String resourcePath = normalizedPath(url.toString());
+    String hrefPath = normalizedPath(href);
+    return !hrefPath.isEmpty() && (
+      resourcePath.equals(hrefPath) || resourcePath.endsWith("/" + hrefPath)
+    );
+  }
+
+  private static String normalizedPath(String value) {
+    String withoutFragment = value.split("#", 2)[0];
+    String path = Uri.parse(withoutFragment).getPath();
+    if (path == null) path = withoutFragment.split("\\?", 2)[0];
+    path = Uri.decode(path);
+    while (path.startsWith("/")) path = path.substring(1);
+    return path;
+  }
+
+  private static int visibleArea(View view) {
+    Rect rect = new Rect();
+    if (!view.isShown() || !view.getGlobalVisibleRect(rect)) return 0;
+    return Math.max(0, rect.width()) * Math.max(0, rect.height());
+  }
+}
