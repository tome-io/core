+    let pageWidth = scrollView.bounds.width
+    guard pageWidth > 0, scrollView.contentSize.width >= pageWidth * 0.99 else {
+      return nil
+    }
+    let count = max(1, Int(ceil(scrollView.contentSize.width / pageWidth)))
